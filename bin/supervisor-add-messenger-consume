#!/bin/sh

# Script to generate supervisor configuration for Symfony messenger:consume command
# Usage: supervisor-add-messenger-consume <receivers> [time-limit]

show_help() {
    echo "Usage: $0 <receivers> [time-limit]"
    echo ""
    echo "Arguments:"
    echo "  receivers       Comma-separated list of receiver/transport names"
    echo "  time-limit      Time limit in seconds (default: 3600)"
    echo ""
    echo "Examples:"
    echo "  $0 async"
    echo "  $0 high,medium 1800"
    echo "  $0 async,sync,email 7200"
    echo ""
    echo "The program name will be automatically generated as 'messenger-consume-<receivers>'"
    echo "The configuration will be written to /etc/supervisor/conf.d/<program-name>.conf"
}

# Check if help is requested
if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ $# -lt 1 ]; then
    show_help
    exit 0
fi

# Parse arguments
RECEIVERS="$1"
TIME_LIMIT="${2:-3600}"

# Validate inputs
if [ -z "$RECEIVERS" ]; then
    echo "Error: Receivers are required"
    exit 1
fi

# Validate time limit is a number
if ! echo "$TIME_LIMIT" | grep -qE '^[0-9]+$'; then
    echo "Error: Time limit must be a positive integer"
    exit 1
fi

# Generate program name from receivers
# Replace commas with dashes and escape any special characters for filename safety
PROGRAM_NAME="messenger-consume-$(echo "$RECEIVERS" | sed 's/,/-/g' | sed 's/[^a-zA-Z0-9_-]/_/g')"

# Convert comma-separated receivers to space-separated for the command
RECEIVERS_FORMATTED=$(echo "$RECEIVERS" | tr ',' ' ')

# Configuration file path
CONF_FILE="/etc/supervisor/conf.d/${PROGRAM_NAME}.conf"

# Generate supervisor configuration
cat > "$CONF_FILE" << EOF
[program:${PROGRAM_NAME}]
command=bin/console messenger:consume ${RECEIVERS_FORMATTED} --time-limit=${TIME_LIMIT}
directory=/var/www
user=www-data
autostart=true
autorestart=true
startretries=3
stdout_logfile=/dev/stdout
stdout_logfile_maxbytes=0
stderr_logfile=/dev/stderr
stderr_logfile_maxbytes=0
EOF

# Check if file was created successfully
if [ $? -eq 0 ]; then
    echo "Supervisor configuration created successfully:"
    echo "  File: $CONF_FILE"
    echo "  Program: $PROGRAM_NAME"
    echo "  Receivers: $RECEIVERS_FORMATTED"
    echo "  Time limit: ${TIME_LIMIT}s"
else
    echo "Error: Failed to create configuration file"
    exit 1
fi
