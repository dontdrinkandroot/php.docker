# Build a custom FrankenPHP binary with additional Caddy modules.
FROM dunglas/frankenphp:1.12.1-builder-php8.5 AS builder
LABEL org.opencontainers.image.authors="Philip Washington Sorst <philip@sorst.net>"

# Keep Composer cache in a predictable location inside the image.
ENV COMPOSER_CACHE_DIR=composer-cache

# Copy xcaddy from the official Caddy builder image.
COPY --from=caddy:builder /usr/bin/xcaddy /usr/bin/xcaddy

# Build FrankenPHP with the required Caddy modules.
# CGO must be enabled for FrankenPHP builds.
RUN CGO_ENABLED=1 \
    XCADDY_SETCAP=1 \
    XCADDY_GO_BUILD_FLAGS="-ldflags='-w -s' -tags=nobadger,nomysql,nopgx" \
    CGO_CFLAGS=$(php-config --includes) \
    CGO_LDFLAGS="$(php-config --ldflags) $(php-config --libs)" \
    xcaddy build \
        --output /usr/local/bin/frankenphp \
        --with github.com/dunglas/frankenphp=./ \
        --with github.com/dunglas/frankenphp/caddy=./caddy/ \
        --with github.com/dunglas/caddy-cbrotli \
        --with github.com/baldinof/caddy-supervisor

# Base runtime image used by both dev and prod variants.
FROM dunglas/frankenphp:1.12.1-php8.5 AS base
LABEL org.opencontainers.image.authors="Philip Washington Sorst <philip@sorst.net>"

# PHP_INI_SCAN_DIR extends PHP's default additional ini scan directory.
# The leading ":" keeps the compiled default scan dir (usually $PHP_INI_DIR/conf.d)
# and adds the application-specific app.conf.d directory after it.
#
# This allows:
# - extension ini files generated by docker-php tooling to stay in conf.d
# - application/runtime overrides to live in app.conf.d
#
# Without the leading ":", PHP would scan only app.conf.d and could miss
# extension-related ini files from conf.d.
ENV COMPOSER_CACHE_DIR=composer-cache \
    PHP_INI_SCAN_DIR=":$PHP_INI_DIR/app.conf.d"

# Replace the upstream FrankenPHP binary with the custom one
# and install the project entrypoint wrapper.
COPY --from=builder /usr/local/bin/frankenphp /usr/local/bin/frankenphp
COPY --link --chmod=755 files/docker-entrypoint /usr/local/bin/docker-entrypoint

# Install required PHP extensions and prepare writable runtime directories.
RUN set -eux; \
    install-php-extensions \
        @composer \
        apcu \
        gd \
        intl \
        opcache \
        pdo_sqlite \
        pdo_pgsql \
        zip; \
    mkdir -p "$PHP_INI_DIR/app.conf.d" \
        /config/caddy \
        /data/caddy/locks; \
    touch "$PHP_INI_DIR/app.conf.d/60_docker_env.ini"; \
    chown www-data:www-data "$PHP_INI_DIR/app.conf.d/60_docker_env.ini"; \
    chown -R www-data:www-data /config/caddy /data/caddy /app;

WORKDIR /app

ENTRYPOINT ["docker-entrypoint"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
EXPOSE 80 443 443/udp

# Development image:
# - uses php.ini-development
# - enables Xdebug
# - adds assertion and Xdebug config in app.conf.d
FROM base AS dev

ENV RUN_DOCTRINE_MIGRATIONS=0 \
    DUMP_COMPOSER_ENV=0

RUN set -eux; \
    mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"; \
    install-php-extensions \
        xdebug;

COPY --link files/assertions.ini $PHP_INI_DIR/app.conf.d/04_assertions.ini
COPY --link files/xdebug.ini $PHP_INI_DIR/app.conf.d/50_xdebug.ini
COPY --link files/dev.Caddyfile /etc/frankenphp/Caddyfile

USER www-data

# Production image:
# - uses php.ini-production
# - enables startup tasks like composer env dump and migrations
# - adds production PHP tuning in app.conf.d
FROM base AS prod

ENV RUN_DOCTRINE_MIGRATIONS=1 \
    DUMP_COMPOSER_ENV=1

RUN set -eux; \
    mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"; \
    mkdir -p /etc/frankenphp/supervisor.d; \
    chown -R www-data:www-data /etc/frankenphp/supervisor.d;

COPY --link files/symfony-prod.ini $PHP_INI_DIR/app.conf.d/50-symfony-prod.ini
COPY --link files/prod.Caddyfile /etc/frankenphp/Caddyfile
COPY --link --chmod=755 files/caddy-add-messenger-consume /usr/local/bin/caddy-add-messenger-consume

USER www-data
