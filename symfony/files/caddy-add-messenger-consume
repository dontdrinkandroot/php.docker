#!/bin/sh

# Script to generate caddy-supervisor configuration for Symfony messenger:consume
# Usage: caddy-add-messenger-consume <receivers> [time-limit]

set -eu

show_help() {
    echo "Usage: $0 <receivers> [time-limit]"
    echo ""
    echo "Arguments:"
    echo "  receivers       Comma-separated list of receiver/transport names"
    echo "  time-limit      Time limit in seconds (default: 3600)"
    echo ""
    echo "Examples:"
    echo "  $0 async"
    echo "  $0 high,medium 1800"
    echo "  $0 async,sync,email 7200"
    echo ""
    echo "The process name will be automatically generated as 'messenger-consume-<receivers>'"
    echo "The configuration will be written to /etc/frankenphp/supervisor.d/<program-name>.caddy"
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || [ $# -lt 1 ]; then
    show_help
    exit 0
fi

RECEIVERS="$1"
TIME_LIMIT="${2:-3600}"
SUPERVISOR_DIR="/etc/frankenphp/supervisor.d"

if [ -z "$RECEIVERS" ]; then
    echo "Error: Receivers are required" >&2
    exit 1
fi

if ! echo "$TIME_LIMIT" | grep -qE '^[0-9]+$'; then
    echo "Error: Time limit must be a positive integer" >&2
    exit 1
fi

PROGRAM_NAME="messenger-consume-$(echo "$RECEIVERS" | sed 's/,/-/g' | sed 's/[^a-zA-Z0-9_-]/_/g')"
RECEIVERS_FORMATTED=$(echo "$RECEIVERS" | tr ',' ' ')
CONF_FILE="${SUPERVISOR_DIR}/${PROGRAM_NAME}.caddy"

mkdir -p "$SUPERVISOR_DIR"

cat > "$CONF_FILE" <<EOF
supervise $PROGRAM_NAME {
    command php /app/bin/console messenger:consume $RECEIVERS_FORMATTED --time-limit=$TIME_LIMIT
    user www-data
    working_dir /app
    redirect_stdout stdout
    redirect_stderr stderr
}
EOF

echo "Caddy supervisor configuration created successfully:"
echo "  File: $CONF_FILE"
echo "  Process: $PROGRAM_NAME"
echo "  Receivers: $RECEIVERS_FORMATTED"
echo "  Time limit: ${TIME_LIMIT}s"
